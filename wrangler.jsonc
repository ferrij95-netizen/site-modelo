// Publica dist/ como site estático no Cloudflare (Workers com assets).
// No Cloudflare Pages este arquivo é ignorado: lá use build `npm run build` e saída `dist`.
{
  "name": "site-modelo",
  "compatibility_date": "2026-09-01",
  // Endereço do preview no domínio da agência (o domínio precisa estar nesta conta Cloudflare).
  "routes": [{ "pattern": "site-modelo.overtus.com.br", "custom_domain": true }],
  "assets": {
    "directory": "./dist"
  }
}
