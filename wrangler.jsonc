// Publica dist/ no Cloudflare (Workers com assets).
// O worker em src/worker.js escolhe o site pelo endereço: <cliente>.overtus.com.br serve clientes/<cliente>/.
// No Cloudflare Pages este arquivo é ignorado: lá use build `npm run build` e saída `dist`.
{
  "name": "site-modelo",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  // O wrangler roda o build completo (raiz + clientes/) antes de publicar, seja qual for o comando configurado no painel.
  "build": { "command": "npm run build" },
  // Endereços no domínio da agência (o domínio precisa estar nesta conta Cloudflare). Um por cliente.
  "routes": [
    { "pattern": "site-modelo.overtus.com.br", "custom_domain": true },
    { "pattern": "sulpol.overtus.com.br", "custom_domain": true },
    { "pattern": "hermith.overtus.com.br", "custom_domain": true },
    { "pattern": "hub.overtus.com.br", "custom_domain": true },
    { "pattern": "agrogen.overtus.com.br", "custom_domain": true },
    { "pattern": "agrogen-v2.overtus.com.br", "custom_domain": true },
    { "pattern": "nelsonwendt.overtus.com.br", "custom_domain": true },
    { "pattern": "longlife.overtus.com.br", "custom_domain": true },
    { "pattern": "texian.overtus.com.br", "custom_domain": true },
    { "pattern": "defilippo.overtus.com.br", "custom_domain": true },
    { "pattern": "dht.overtus.com.br", "custom_domain": true },
    { "pattern": "engefrio.overtus.com.br", "custom_domain": true },
    { "pattern": "instor.overtus.com.br", "custom_domain": true },
    { "pattern": "mbembalagens.overtus.com.br", "custom_domain": true },
    { "pattern": "engenho-am.overtus.com.br", "custom_domain": true },
    { "pattern": "metz.overtus.com.br", "custom_domain": true }
  ],
  // Notícias e painel /admin dos clientes que têm notícias (src/noticias.js).
  "d1_databases": [
    { "binding": "NOTICIAS", "database_name": "noticias", "database_id": "57f5cc1b-a111-4f03-a28a-af57c4d3427d" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
